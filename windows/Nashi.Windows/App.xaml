<Application x:Class="Nashi.Windows.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Nashi.Windows" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
<Application.Resources>
 <local:ChoiceTextConverter x:Key="ChoiceText"/>
 <DataTemplate x:Key="ChoiceLabel"><TextBlock><TextBlock.Text><MultiBinding Converter="{StaticResource ChoiceText}"><Binding/><Binding Path="Language" Source="{x:Static local:LanguageState.Shared}"/></MultiBinding></TextBlock.Text></TextBlock></DataTemplate>

 <!-- Ink & Coral palette. Theme.Apply replaces these brushes for light and dark. -->
 <SolidColorBrush x:Key="Ink" Color="#111214"/><SolidColorBrush x:Key="Muted" Color="#B8111214"/><SolidColorBrush x:Key="Faint" Color="#80111214"/>
 <SolidColorBrush x:Key="Paper" Color="#F4F3F0"/><SolidColorBrush x:Key="Card" Color="#9EFFFFFF"/><SolidColorBrush x:Key="Well" Color="#7AFFFFFF"/>
 <SolidColorBrush x:Key="WellHover" Color="#ADFFFFFF"/><SolidColorBrush x:Key="Raised" Color="#DBFFFFFF"/><SolidColorBrush x:Key="Sel" Color="#13111214"/>
 <SolidColorBrush x:Key="Hover" Color="#0D111214"/><SolidColorBrush x:Key="Line" Color="#1A111214"/><SolidColorBrush x:Key="LineStrong" Color="#29111214"/>
 <SolidColorBrush x:Key="Coral" Color="#F2553A"/><SolidColorBrush x:Key="OnCoral" Color="#111214"/><SolidColorBrush x:Key="Solid" Color="#111214"/>
 <SolidColorBrush x:Key="OnSolid" Color="#F7F6F3"/><SolidColorBrush x:Key="Menu" Color="#FBFAF8"/><SolidColorBrush x:Key="Media" Color="#E7E6E2"/>
 <SolidColorBrush x:Key="Keycap" Color="#9EFFFFFF"/><SolidColorBrush x:Key="Danger" Color="#D93036"/>
 <SolidColorBrush x:Key="Petal" Color="#80FFFFFF"/><SolidColorBrush x:Key="PetalStroke" Color="#E6FFFFFF"/><SolidColorBrush x:Key="Clear" Color="#1AFFFFFF"/>
 <SolidColorBrush x:Key="GlassDock" Color="#99FBFAF8"/><SolidColorBrush x:Key="Glass" Color="#38FFFFFF"/><SolidColorBrush x:Key="GlassStrong" Color="#D6FBFAF8"/><SolidColorBrush x:Key="Slab" Color="#9EF7F6F3"/>
 <SolidColorBrush x:Key="Focus" Color="#66111214"/><SolidColorBrush x:Key="Panel" Color="#B8FBFAF8"/><SolidColorBrush x:Key="Rim" Color="#80FFFFFF"/><SolidColorBrush x:Key="ThumbRim" Color="#80FFFFFF"/><SolidColorBrush x:Key="SignatureRim" Color="#38FFFFFF"/>
 <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
 <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
 <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
 <!-- One light from above: every shadow falls straight down. -->
 <DropShadowEffect x:Key="PanelShadow" BlurRadius="28" ShadowDepth="8" Direction="270" Opacity=".16" Color="#000000"/>
 <DropShadowEffect x:Key="ButtonShadow" BlurRadius="12" ShadowDepth="3" Direction="270" Opacity=".16" Color="#000000"/>
 <DropShadowEffect x:Key="ThumbShadow" BlurRadius="12" ShadowDepth="2.5" Direction="270" Opacity=".14" Color="#000000"/>
 <!-- Keyboard focus only (Tab): a quiet ink ring. A click never shows it, and nothing turns coral. -->
 <Style x:Key="KeyFocus"><Setter Property="Control.Template"><Setter.Value><ControlTemplate><local:RoundBorder Radius="99" Margin="-3" BorderThickness="2" BorderBrush="{DynamicResource Focus}"/></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="KeyFocusRow"><Setter Property="Control.Template"><Setter.Value><ControlTemplate><Border CornerRadius="12" Margin="-2" BorderThickness="2" BorderBrush="{DynamicResource Focus}"/></ControlTemplate></Setter.Value></Setter></Style>

 <Style TargetType="Window"><Setter Property="Background" Value="{DynamicResource Paper}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FontFamily" Value="{StaticResource UiFont}"/><Setter Property="FontSize" Value="13"/></Style>

 <!-- Buttons: instant press feedback; a quiet ring only for keyboard focus. Content stays the plain label; Ui.Icon and Ui.Hint add an icon and a shortcut. -->
 <Style TargetType="Button">
  <Setter Property="FocusVisualStyle" Value="{StaticResource KeyFocus}"/>
  <Setter Property="Padding" Value="14,0"/><Setter Property="Margin" Value="4"/><Setter Property="MinHeight" Value="30"/>
  <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Well}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/>
  <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="FontWeight" Value="Medium"/><Setter Property="Cursor" Value="Hand"/><Setter Property="local:Ui.Radius" Value="99"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Grid x:Name="Root" RenderTransformOrigin=".5,.5"><Grid.RenderTransform><ScaleTransform x:Name="Scale"/></Grid.RenderTransform>
    <local:RoundBorder x:Name="Lift" Radius="{TemplateBinding local:Ui.Radius}" Background="{TemplateBinding Background}" Effect="{StaticResource ButtonShadow}" Visibility="Collapsed"/>
    <local:Lens Preset="{TemplateBinding local:Ui.Lens}" Radius="{TemplateBinding local:Ui.Radius}"/>
    <local:RoundBorder x:Name="Chrome" Radius="{TemplateBinding local:Ui.Radius}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
    <local:RoundBorder x:Name="Hover" Radius="{TemplateBinding local:Ui.Radius}" Background="{DynamicResource Hover}" Opacity="0"/>
    <DockPanel Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
     <ContentPresenter x:Name="Glyph" DockPanel.Dock="Left" Content="{TemplateBinding local:Ui.Icon}" Margin="0,0,7,0" VerticalAlignment="Center"/>
     <TextBlock x:Name="Hint" DockPanel.Dock="Right" Text="{TemplateBinding local:Ui.Hint}" FontSize="11.5" FontWeight="Medium" Opacity=".55" Margin="9,0,0,0" VerticalAlignment="Center"/>
     <ContentPresenter x:Name="Label" VerticalAlignment="Center" RecognizesAccessKey="True" TextBlock.TextAlignment="Center"/>
    </DockPanel>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="local:Ui.Lift" Value="True"><Setter TargetName="Lift" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="local:Ui.Icon" Value="{x:Null}"><Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/></Trigger>
    <Trigger Property="local:Ui.IconOnly" Value="True"><Setter TargetName="Glyph" Property="Margin" Value="0"/><Setter TargetName="Label" Property="Visibility" Value="Collapsed"/></Trigger>
    <Trigger Property="local:Ui.Hint" Value="{x:Null}"><Setter TargetName="Hint" Property="Visibility" Value="Collapsed"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
    <Trigger Property="IsPressed" Value="True">
     <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.965" Duration="0:0:0.08"/><DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.965" Duration="0:0:0.08"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
     <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16"/><DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
    </Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <!-- The one primary action on a screen. -->
 <Style x:Key="Signature" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="{DynamicResource Coral}"/><Setter Property="Foreground" Value="{DynamicResource OnCoral}"/><Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="BorderBrush" Value="{DynamicResource SignatureRim}"/><Setter Property="Padding" Value="18,0"/><Setter Property="MinHeight" Value="38"/><Setter Property="local:Ui.Lift" Value="True"/>
 </Style>
 <Style x:Key="Big" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="18,0"/><Setter Property="MinHeight" Value="38"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 <Style x:Key="GlassButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource Glass}"/><Setter Property="BorderBrush" Value="{DynamicResource Rim}"/><Setter Property="local:Ui.Lens" Value="control"/><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="15,0"/></Style>
 <Style x:Key="Plain" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,0"/></Style>
 <Style x:Key="Round" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="FontFamily" Value="{StaticResource IconFont}"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="FontSize" Value="15"/></Style>
 <Style x:Key="GlassRound" TargetType="Button" BasedOn="{StaticResource Round}"><Setter Property="Background" Value="{DynamicResource Glass}"/><Setter Property="BorderBrush" Value="{DynamicResource Rim}"/><Setter Property="local:Ui.Lens" Value="control"/><Setter Property="Width" Value="38"/><Setter Property="Height" Value="38"/></Style>
 <Style x:Key="IconPlain" TargetType="Button" BasedOn="{StaticResource Round}"><Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Margin" Value="1,0"/><Setter Property="FontSize" Value="13"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
 <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="11,0"/><Setter Property="MinHeight" Value="28"/><Setter Property="Margin" Value="3,0"/><Setter Property="FontSize" Value="11.5"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 <Style x:Key="Tile" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="local:Ui.Radius" Value="16"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FontWeight" Value="Normal"/></Style>
 <Style x:Key="CardButton" TargetType="Button" BasedOn="{StaticResource Tile}"><Setter Property="local:Ui.Radius" Value="18"/><Setter Property="Background" Value="{DynamicResource Card}"/><Setter Property="Padding" Value="11,11,14,11"/></Style>
 <Style x:Key="Segment" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="16,0"/><Setter Property="MinHeight" Value="30"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/>
  <Style.Triggers><Trigger Property="local:Ui.On" Value="True"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></Style.Triggers>
 </Style>
 <Style x:Key="SegmentSmall" TargetType="Button" BasedOn="{StaticResource Segment}"><Setter Property="Padding" Value="11,0"/><Setter Property="MinHeight" Value="25"/><Setter Property="FontSize" Value="12"/></Style>
 <!-- Window caption buttons, drawn inside the frame when the system does not draw them. -->
 <Style x:Key="Caption" TargetType="Button">
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/><Setter Property="Width" Value="46"/><Setter Property="Height" Value="46"/>
  <Setter Property="FontFamily" Value="{StaticResource IconFont}"/><Setter Property="FontSize" Value="10"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="Transparent"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Back" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Back" Property="Background" Value="{DynamicResource Sel}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Back" Property="Background" Value="{DynamicResource LineStrong}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource Caption}">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Back" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Back" Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Back" Property="Background" Value="#C83C30"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="WheelLabelButton" TargetType="Button"><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>

 <!-- Window frames. The content comes first so it also comes first for keyboard focus and lookups. -->
 <ControlTemplate x:Key="ToolbarFrame" TargetType="Window">
  <Grid Background="{TemplateBinding Background}"><local:Backdrop/><Border x:Name="Root"><Grid>
   <AdornerDecorator><ContentPresenter/></AdornerDecorator>
   <StackPanel x:Name="Captions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button x:Name="Min" Style="{StaticResource Caption}" Content="&#xE921;" Command="{x:Static SystemCommands.MinimizeWindowCommand}" AutomationProperties.Name="Minimize"/>
    <Button x:Name="Max" Style="{StaticResource Caption}" Content="&#xE922;" Command="{x:Static SystemCommands.MaximizeWindowCommand}" AutomationProperties.Name="Maximize"/>
    <Button Style="{StaticResource CaptionClose}" Content="&#xE8BB;" Command="{x:Static SystemCommands.CloseWindowCommand}" AutomationProperties.Name="Close"/>
   </StackPanel>
  </Grid></Border><Border x:Name="Rim" BorderBrush="{DynamicResource Rim}" BorderThickness="1" CornerRadius="8" IsHitTestVisible="False"/></Grid>
  <ControlTemplate.Triggers>
   <Trigger Property="WindowState" Value="Maximized"><Setter TargetName="Root" Property="Padding" Value="8"/><Setter TargetName="Rim" Property="Visibility" Value="Collapsed"/><Setter TargetName="Max" Property="Content" Value="&#xE923;"/><Setter TargetName="Max" Property="Command" Value="{x:Static SystemCommands.RestoreWindowCommand}"/><Setter TargetName="Max" Property="AutomationProperties.Name" Value="Restore"/></Trigger>
   <Trigger Property="ResizeMode" Value="NoResize"><Setter TargetName="Min" Property="Visibility" Value="Collapsed"/><Setter TargetName="Max" Property="Visibility" Value="Collapsed"/></Trigger>
   <Trigger Property="ResizeMode" Value="CanMinimize"><Setter TargetName="Max" Property="Visibility" Value="Collapsed"/></Trigger>
   <Trigger Property="IsActive" Value="False"><Setter TargetName="Captions" Property="Opacity" Value=".45"/></Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate>
 <ControlTemplate x:Key="TitledFrame" TargetType="Window">
  <Grid Background="{TemplateBinding Background}"><local:Backdrop/><Border x:Name="Root"><Grid>
   <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition/></Grid.RowDefinitions>
   <AdornerDecorator Grid.Row="1"><ContentPresenter/></AdornerDecorator>
   <StackPanel x:Name="Title" Orientation="Horizontal" Margin="18,0,150,0" VerticalAlignment="Center" IsHitTestVisible="False">
    <Image Source="pack://application:,,,/Assets/NashiIcon.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
    <TextBlock Text="Nashi" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
    <TextBlock Text="{TemplateBinding local:Ui.Heading}" Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
   </StackPanel>
   <StackPanel x:Name="Captions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button x:Name="Min" Style="{StaticResource Caption}" Content="&#xE921;" Command="{x:Static SystemCommands.MinimizeWindowCommand}" AutomationProperties.Name="Minimize"/>
    <Button x:Name="Max" Style="{StaticResource Caption}" Content="&#xE922;" Command="{x:Static SystemCommands.MaximizeWindowCommand}" AutomationProperties.Name="Maximize"/>
    <Button Style="{StaticResource CaptionClose}" Content="&#xE8BB;" Command="{x:Static SystemCommands.CloseWindowCommand}" AutomationProperties.Name="Close"/>
   </StackPanel>
  </Grid></Border><Border x:Name="Rim" BorderBrush="{DynamicResource Rim}" BorderThickness="1" CornerRadius="8" IsHitTestVisible="False"/></Grid>
  <ControlTemplate.Triggers>
   <Trigger Property="WindowState" Value="Maximized"><Setter TargetName="Root" Property="Padding" Value="8"/><Setter TargetName="Rim" Property="Visibility" Value="Collapsed"/><Setter TargetName="Max" Property="Content" Value="&#xE923;"/><Setter TargetName="Max" Property="Command" Value="{x:Static SystemCommands.RestoreWindowCommand}"/><Setter TargetName="Max" Property="AutomationProperties.Name" Value="Restore"/></Trigger>
   <Trigger Property="ResizeMode" Value="NoResize"><Setter TargetName="Min" Property="Visibility" Value="Collapsed"/><Setter TargetName="Max" Property="Visibility" Value="Collapsed"/></Trigger>
   <Trigger Property="ResizeMode" Value="CanMinimize"><Setter TargetName="Max" Property="Visibility" Value="Collapsed"/></Trigger>
   <Trigger Property="IsActive" Value="False"><Setter TargetName="Captions" Property="Opacity" Value=".45"/><Setter TargetName="Title" Property="Opacity" Value=".6"/></Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate>

 <!-- Text input -->
 <Style TargetType="TextBox">
  <Setter Property="Padding" Value="9,6"/><Setter Property="Margin" Value="4"/><Setter Property="MinHeight" Value="32"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Background" Value="{DynamicResource Well}"/>
  <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="CaretBrush" Value="{DynamicResource Ink}"/><Setter Property="SelectionBrush" Value="{DynamicResource Coral}"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10"><ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/></Border>
   <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource LineStrong}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <!-- A capsule field with a leading icon (Ui.Glyph) and a placeholder (Ui.Hint), for search and links. -->
 <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
  <Setter Property="Padding" Value="2,6"/><Setter Property="MinHeight" Value="34"/><Setter Property="local:Ui.Radius" Value="99"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Grid><local:Lens Preset="{TemplateBinding local:Ui.Lens}"/><local:RoundBorder x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Radius="{TemplateBinding local:Ui.Radius}" Padding="12,0,8,0"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ContentPresenter Content="{TemplateBinding local:Ui.Icon}" Margin="0,0,7,0" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource Faint}"/>
    <Border x:Name="Keys" Grid.Column="2" MinWidth="21" Height="19" Padding="5,0" CornerRadius="6" BorderThickness="1,1,1,2" Background="{DynamicResource Keycap}" BorderBrush="{DynamicResource Line}" VerticalAlignment="Center"><ContentPresenter Content="{TemplateBinding Tag}" VerticalAlignment="Center" HorizontalAlignment="Center" TextElement.FontSize="11" TextElement.FontWeight="SemiBold"/></Border>
    <TextBlock x:Name="Placeholder" Grid.Column="1" Text="{TemplateBinding local:Ui.Hint}" Foreground="{DynamicResource Faint}" Margin="4,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
    <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Margin="0" VerticalAlignment="Center"/>
   </Grid></local:RoundBorder></Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="Tag" Value="{x:Null}"><Setter TargetName="Keys" Property="Visibility" Value="Collapsed"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource LineStrong}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <!-- A small field with a unit after the value (px), as in the editor's Size and Position panel. The unit is Tag. -->
 <Style x:Key="Unit" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="2,4"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,0,10,0"><DockPanel>
    <ContentPresenter DockPanel.Dock="Right" Content="{TemplateBinding Tag}" VerticalAlignment="Center" TextElement.FontSize="12" TextElement.Foreground="{DynamicResource Faint}"/>
    <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/></DockPanel></Border>
   <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource LineStrong}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="PasswordBox">
  <Setter Property="Padding" Value="9,6"/><Setter Property="Margin" Value="4"/><Setter Property="MinHeight" Value="32"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Background" Value="{DynamicResource Well}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="CaretBrush" Value="{DynamicResource Ink}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10"><ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/></Border>
   <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource LineStrong}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>

 <!-- Pop-up menus -->
 <Style TargetType="ComboBox"><Setter Property="ItemTemplate" Value="{StaticResource ChoiceLabel}"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyFocus}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Padding" Value="11,4"/><Setter Property="Margin" Value="4"/><Setter Property="MinWidth" Value="140"/><Setter Property="MinHeight" Value="28"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Well}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
   <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Field" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1" CornerRadius="9"><Viewbox Width="11" Height="11" HorizontalAlignment="Right" Margin="0,0,9,0" VerticalAlignment="Center"><Grid Width="20" Height="20"><Path Data="M6.8,7.8 L10,4.6 L13.2,7.8 M6.8,12.2 L10,15.4 L13.2,12.2" Stroke="{DynamicResource Muted}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Grid></Viewbox></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="Background" Value="{DynamicResource WellHover}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
   <ContentPresenter Margin="11,4,28,4" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center"/>
   <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None"><Border Margin="10,4,10,14" Effect="{StaticResource PanelShadow}" Background="{DynamicResource Menu}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="12" MinWidth="{TemplateBinding ActualWidth}" Padding="5"><ScrollViewer MaxHeight="320"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
  </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <!-- A choice shown as a segmented capsule (Appearance, Format). It is still a ComboBox for keyboard and tests.
      The chosen item rests on a glass droplet taller than the track; it glides with a spring (App.Segment*). -->
 <Style x:Key="SegmentedCombo" TargetType="ComboBox"><Setter Property="FocusVisualStyle" Value="{StaticResource KeyFocus}"/><Setter Property="MinWidth" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="ItemTemplate" Value="{StaticResource ChoiceLabel}"/>
  <EventSetter Event="Loaded" Handler="SegmentReady"/><EventSetter Event="SelectionChanged" Handler="SegmentChanged"/><EventSetter Event="SizeChanged" Handler="SegmentSized"/><EventSetter Event="PreviewKeyDown" Handler="SegmentKey"/>
  <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></Setter.Value></Setter>
  <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Medium"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Grid MinHeight="25" Background="Transparent"><ContentPresenter Margin="11,0" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid>
    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter>
