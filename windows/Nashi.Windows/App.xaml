 <!-- Settings-style switch: label on the left, switch on the right. -->
 <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyFocus}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="0,0,14,0"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><DockPanel Background="Transparent" LastChildFill="True">
   <Grid DockPanel.Dock="Right" Width="40" Height="24" VerticalAlignment="Center">
    <Border x:Name="Track" CornerRadius="12" Background="{DynamicResource Sel}" BorderBrush="{DynamicResource Line}" BorderThickness="1"/>
    <Ellipse x:Name="Knob" Width="20" Height="20" HorizontalAlignment="Left" Margin="2,0,0,0" Fill="#FFFFFF"><Ellipse.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity=".3"/></Ellipse.Effect><Ellipse.RenderTransform><TranslateTransform x:Name="Slide"/></Ellipse.RenderTransform></Ellipse>
   </Grid>
   <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" RecognizesAccessKey="True"><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></ContentPresenter.Resources></ContentPresenter>
  </DockPanel><ControlTemplate.Triggers>
   <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource Solid}"/><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Solid}"/><Setter TargetName="Knob" Property="Fill" Value="{DynamicResource OnSolid}"/>
    <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
    <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
   </Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
  </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="Slider"><Setter Property="FocusVisualStyle" Value="{StaticResource KeyFocus}"/><Setter Property="MinHeight" Value="24"/>
