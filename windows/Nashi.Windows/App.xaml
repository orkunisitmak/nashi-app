 <Style TargetType="ProgressBar"><Setter Property="Height" Value="5"/><Setter Property="Foreground" Value="{DynamicResource Solid}"/><Setter Property="Background" Value="{DynamicResource Sel}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid ClipToBounds="True">
   <Border x:Name="PART_Track" CornerRadius="3" Background="{TemplateBinding Background}"/>
   <Border x:Name="PART_Indicator" CornerRadius="3" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
   <Border x:Name="Sweep" CornerRadius="3" Background="{TemplateBinding Foreground}" Width="90" HorizontalAlignment="Left" Visibility="Collapsed"><Border.RenderTransform><TranslateTransform x:Name="Run" X="-90"/></Border.RenderTransform></Border>
  </Grid><ControlTemplate.Triggers><Trigger Property="IsIndeterminate" Value="True"><Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/><Setter TargetName="Sweep" Property="Visibility" Value="Visible"/></Trigger>
   <!-- The sweep runs only while it can be seen: an endless animation on a hidden bar (a finished job card, a closed toast) keeps WPF drawing every frame. -->
   <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsIndeterminate" Value="True"/><Condition Property="IsVisible" Value="True"/></MultiTrigger.Conditions>
    <MultiTrigger.EnterActions><BeginStoryboard x:Name="Indeterminate"><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetName="Run" Storyboard.TargetProperty="X" From="-90" To="560" Duration="0:0:1.4"/></Storyboard></BeginStoryboard></MultiTrigger.EnterActions>
    <MultiTrigger.ExitActions><StopStoryboard BeginStoryboardName="Indeterminate"/></MultiTrigger.ExitActions></MultiTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="Expander"><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><DockPanel>
   <ToggleButton DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Cursor="Hand" FocusVisualStyle="{x:Null}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Head" Background="Transparent" CornerRadius="8" Padding="8,6"><StackPanel Orientation="Horizontal"><TextBlock x:Name="Chevron" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" RenderTransformOrigin=".5,.5"/><ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" TextBlock.FontWeight="SemiBold"/></StackPanel></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Head" Property="Background" Value="{DynamicResource Hover}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
   <ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="0,6,0,0"/>
  </DockPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
