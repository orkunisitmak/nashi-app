<Project>
  <Import Project="../windows/Directory.Build.props" />
  <PropertyGroup>
    <PathMap>$(MSBuildThisFileDirectory)=/_/linux/</PathMap>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AvaloniaTelemetryEnabled>false</AvaloniaTelemetryEnabled>
  </PropertyGroup>
</Project>
