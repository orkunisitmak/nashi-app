<!-- Brutalist: flat paper, heavy ink outlines, square corners, hard offset shadows and a loud
     yellow for anything you can press. Readable at a glance, nothing translucent. -->
<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Paper" Color="#F2EEE3"/>
          <SolidColorBrush x:Key="Ink" Color="#0A0A0A"/>
          <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="Inset" Color="#F2EEE3"/>
          <SolidColorBrush x:Key="Muted" Color="#2E2E2E"/>
          <SolidColorBrush x:Key="Line" Color="#0A0A0A"/>
          <SolidColorBrush x:Key="Sage" Color="#B9F5C4"/>
          <SolidColorBrush x:Key="Sand" Color="#FFD6E8"/>
          <SolidColorBrush x:Key="Scrim" Color="#99F2EEE3"/>
          <SolidColorBrush x:Key="Hard" Color="#0A0A0A"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Paper" Color="#121212"/>
          <SolidColorBrush x:Key="Ink" Color="#F5F5F0"/>
          <SolidColorBrush x:Key="Surface" Color="#1C1C1C"/>
          <SolidColorBrush x:Key="Inset" Color="#121212"/>
          <SolidColorBrush x:Key="Muted" Color="#D6D6D0"/>
          <SolidColorBrush x:Key="Line" Color="#F5F5F0"/>
          <SolidColorBrush x:Key="Sage" Color="#1F5C33"/>
          <SolidColorBrush x:Key="Sand" Color="#6B1F45"/>
          <SolidColorBrush x:Key="Scrim" Color="#B3121212"/>
          <SolidColorBrush x:Key="Hard" Color="#FFE14D"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <SolidColorBrush x:Key="Gold" Color="#FFE14D"/>
      <SolidColorBrush x:Key="GoldInk" Color="#0A0A0A"/>
      <SolidColorBrush x:Key="GoldHover" Color="#FFEC80"/>
      <SolidColorBrush x:Key="GoldText" Color="#E0B400"/>
      <SolidColorBrush x:Key="WheelLine" Color="#0A0A0A"/>
      <Color x:Key="SystemAccentColor">#0A0A0A</Color>
      <Color x:Key="SystemAccentColorDark1">#0A0A0A</Color>
      <Color x:Key="SystemAccentColorDark2">#0A0A0A</Color>
      <Color x:Key="SystemAccentColorDark3">#0A0A0A</Color>
      <Color x:Key="SystemAccentColorLight1">#FFE14D</Color>
      <Color x:Key="SystemAccentColorLight2">#FFE14D</Color>
      <Color x:Key="SystemAccentColorLight3">#FFE14D</Color>
    </ResourceDictionary>
  </Styles.Resources>
  <Style Selector="TextBlock.title">
    <Setter Property="FontWeight" Value="Black"/>
  </Style>
  <Style Selector="Border.card">
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="BorderThickness" Value="3"/>
    <Setter Property="BoxShadow" Value="7 7 0 0 #0A0A0A"/>
  </Style>
  <Style Selector="Border.inset, Border.pill">
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
    <Setter Property="BorderThickness" Value="2"/>
  </Style>
  <Style Selector="Border.disc">
    <Setter Property="CornerRadius" Value="0"/>
  </Style>
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="BorderThickness" Value="3"/>
    <Setter Property="BorderBrush" Value="#0A0A0A"/>
  </Style>
  <Style Selector="Button.chip">
    <Setter Property="CornerRadius" Value="0"/>
  </Style>
  <Style Selector="Button.wheel">
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="BorderThickness" Value="3"/>
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Gold}"/>
    <Setter Property="Foreground" Value="{DynamicResource GoldInk}"/>
  </Style>
  <Style Selector="TextBox, ComboBox, NumericUpDown">
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="BorderThickness" Value="2"/>
  </Style>
</Styles>
