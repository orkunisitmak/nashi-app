<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Nashi.Linux.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Nashi/Theme/Palette.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <!-- Fluent's accent (sliders, check boxes, focus, text selection) is the palette's ink: black in light, white in
         dark. Gold stays for the primary action and the selection, which Nashi's own styles draw. -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#000000" />
        <ColorPaletteResources x:Key="Dark" Accent="#FFFFFF" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Nashi/Theme/Controls.axaml" />
  </Application.Styles>
</Application>
