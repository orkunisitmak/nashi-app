<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Nashi.Linux.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Nashi/Theme/Palette.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <!-- Gold is the accent of every Fluent control the editors use (checked, focused, selected, slider fill). -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#E3B859" />
        <ColorPaletteResources x:Key="Dark" Accent="#E3B859" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Nashi/Theme/Controls.axaml" />
  </Application.Styles>
</Application>
