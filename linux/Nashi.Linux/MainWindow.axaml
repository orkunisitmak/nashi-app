<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Nashi.Linux"
        xmlns:l="using:Nashi.Linux"
        x:Class="Nashi.Linux.MainWindow"
        x:DataType="local:MainWindow"
        Title="Nashi"
        Icon="avares://Nashi/Assets/NashiIcon.png"
        Width="820" Height="780" MinWidth="700" MinHeight="580"
        DragDrop.AllowDrop="True">
  <DockPanel>
    <!-- Header -->
    <Grid DockPanel.Dock="Top" Margin="28,19,28,15" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
      <Image Source="avares://Nashi/Assets/NashiMark.png" Width="40" Height="40" />
      <TextBlock Grid.Column="1" Text="Nashi" Margin="10,0,0,0" FontSize="19" FontWeight="Bold" LetterSpacing="-0.5" VerticalAlignment="Center" />
      <Button x:Name="SetUpToolsButton" Grid.Column="3" Classes="secondary compact" Content="{l:T 'Set up tools'}" Click="OnSetUpTools" VerticalAlignment="Center" />
      <Border Grid.Column="4" Classes="pill" Margin="10,0">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <PathIcon Data="{StaticResource IconLock}" />
          <TextBlock Text="{l:T 'On your computer'}" />
        </StackPanel>
      </Border>
      <Button x:Name="SettingsButton" Grid.Column="5" Classes="quiet compact" IsEnabled="False" ToolTip.Tip="{l:T 'Coming soon'}" ToolTip.ShowOnDisabled="True" AutomationProperties.Name="{l:T 'Settings'}" VerticalAlignment="Center">
        <PathIcon Data="{StaticResource IconSliders}" Width="15" Height="15" />
      </Button>
    </Grid>

    <ScrollViewer>
      <StackPanel Margin="28,0,28,24" Spacing="22">
        <!-- Hero -->
        <StackPanel Spacing="6" Margin="0,8,0,0">
          <TextBlock Text="{l:T 'Your files. Their next form.'}" FontSize="30" FontWeight="Bold" LetterSpacing="-0.9" />
          <TextBlock Classes="secondary" Text="{l:T 'Convert, fine-tune, and send them on their way.'}" FontSize="13" />
        </StackPanel>

        <!-- Start card -->
        <Border x:Name="StartCard" Classes="card" CornerRadius="22" Padding="24">
          <StackPanel Spacing="18">
            <Grid ColumnDefinitions="*,166">
              <StackPanel Spacing="12" VerticalAlignment="Center">
                <Border Classes="pill gold">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <PathIcon Data="{StaticResource IconSparkle}" />
                    <TextBlock x:Name="StartPillText" Text="{l:T 'START HERE'}" LetterSpacing="0.4" />
                  </StackPanel>
                </Border>
                <TextBlock x:Name="SelectionTitle" Text="{l:T 'Drop something good.'}" FontSize="23" FontWeight="Bold" LetterSpacing="-0.5" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                <TextBlock x:Name="SelectionDetail" Classes="secondary" Text="{l:T 'Images, videos, documents, and all the little things in between.'}" FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                <Button x:Name="ChooseButton" Classes="primary" Click="OnChooseFiles" Margin="0,3,0,0">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IconPlus}" Width="11" Height="11" />
                    <TextBlock x:Name="ChooseLabel" Text="{l:T 'Choose files'}" />
                  </StackPanel>
                </Button>
              </StackPanel>

              <!-- File garden illustration -->
              <Canvas Grid.Column="1" Width="166" Height="150" IsHitTestVisible="False">
                <Ellipse Canvas.Left="11" Canvas.Top="3" Width="144" Height="144" Fill="{DynamicResource NashiSand}" />
                <Border Canvas.Left="10.5" Canvas.Top="35.5" Width="77" Height="103" CornerRadius="15" Padding="13"
                        Background="{DynamicResource NashiSurface}" BorderBrush="#1F30543B" BorderThickness="1"
                        BoxShadow="0 5 12 0 #12000000" RenderTransform="rotate(-16deg)">
                  <StackPanel Spacing="10">
                    <PathIcon Data="{StaticResource IconDocument}" Width="22" Height="22" HorizontalAlignment="Left" Foreground="{DynamicResource NashiForest}" />
                    <TextBlock Text="PDF" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource NashiForest}" />
                    <Border Width="37" Height="4" CornerRadius="2" HorizontalAlignment="Left" Background="{DynamicResource NashiForest}" Opacity="0.18" />
                  </StackPanel>
                </Border>
                <Border Canvas.Left="75.5" Canvas.Top="21.5" Width="77" Height="103" CornerRadius="15" Padding="13"
                        Background="{DynamicResource NashiSurface}" BorderBrush="#1FE3B859" BorderThickness="1"
                        BoxShadow="0 5 12 0 #12000000" RenderTransform="rotate(7deg)">
                  <StackPanel Spacing="10">
                    <PathIcon Data="{StaticResource IconPhoto}" Width="22" Height="22" HorizontalAlignment="Left" Foreground="{DynamicResource NashiGold}" />
                    <TextBlock Text="PNG" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource NashiGold}" />
                    <Border Width="37" Height="4" CornerRadius="2" HorizontalAlignment="Left" Background="{DynamicResource NashiGold}" Opacity="0.18" />
                  </StackPanel>
                </Border>
                <Image x:Name="GardenMark" Canvas.Left="50.5" Canvas.Top="84.5" Width="65" Height="65" Source="avares://Nashi/Assets/NashiMark.png" />
              </Canvas>
            </Grid>

            <!-- Selected files -->
            <StackPanel x:Name="SelectionPanel" Spacing="8" IsVisible="False">
              <Grid ColumnDefinitions="*,Auto">
                <ItemsControl x:Name="FileChips">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel ItemSpacing="8" LineSpacing="8" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:FileChip">
                      <Border Background="{DynamicResource NashiCanvas}" CornerRadius="9" Padding="9,4,4,4">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="Medium" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          <Button Classes="quiet" Padding="4" CornerRadius="6" Tag="{Binding Path}" Click="OnRemoveFile"
                                  ToolTip.Tip="{Binding RemoveTip}"
                                  AutomationProperties.Name="{Binding RemoveName}">
                            <PathIcon Data="{StaticResource IconClose}" Width="8" Height="8" />
                          </Button>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Grid.Column="1" Classes="quiet compact" Content="{l:T 'Clear'}" Click="OnClear" VerticalAlignment="Top" />
              </Grid>
            </StackPanel>
            <TextBlock x:Name="StatusLine" Classes="secondary" FontSize="11" IsVisible="False" TextWrapping="Wrap" />

            <!-- Convert opens the format wheel, Tools the tools wheel (also Ctrl+Space). -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
              <Button Classes="chip" Click="OnConvert">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IconConvert}" />
                  <TextBlock Text="{l:T 'Convert'}" />
                </StackPanel>
              </Button>
              <Button Classes="chip" Click="OnTools">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IconTools}" />
                  <TextBlock Text="{l:T 'Tools'}" />
                </StackPanel>
              </Button>
              <Button Classes="chip" IsEnabled="False" ToolTip.Tip="{l:T 'Coming soon'}" ToolTip.ShowOnDisabled="True">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IconActions}" />
                  <TextBlock Text="{l:T 'Actions'}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Download a link: not in this milestone. -->
        <Button Classes="cardButton" IsEnabled="False" ToolTip.Tip="{l:T 'Coming soon'}" ToolTip.ShowOnDisabled="True">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Grid Width="25" Height="25" VerticalAlignment="Center">
              <Ellipse Fill="{DynamicResource NashiGold}" />
              <PathIcon Data="{StaticResource IconArrowDown}" Width="15" Height="15" Foreground="White" />
            </Grid>
            <StackPanel Spacing="4">
              <TextBlock Text="{l:T 'Download a link'}" FontSize="14" FontWeight="Bold" />
              <TextBlock Classes="secondary" Text="{l:T 'Video, audio, or an image. Straight into your tools.'}" FontSize="11" />
            </StackPanel>
          </StackPanel>
        </Button>

        <!-- Footer -->
        <Grid ColumnDefinitions="Auto,*,Auto" TextElement.FontSize="10" TextElement.FontWeight="Medium">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource IconLeaf}" Width="11" Height="11" Foreground="{DynamicResource NashiTextSecondary}" />
            <TextBlock Classes="secondary" Text="{l:T 'A little less file fuss. A little more flow.'}" />
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{l:T 'Made for Linux'}" Foreground="{DynamicResource NashiTextTertiary}" />
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
