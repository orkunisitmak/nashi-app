<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Nashi.Linux.SuccessToast"
        xmlns:l="using:Nashi.Linux"
        Title="{l:T 'Nashi — Complete'}"
        Width="560" Height="88" CanResize="False"
        SystemDecorations="None" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual"
        Background="Transparent" TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="{DynamicResource NashiCanvasOpaque}">
  <!-- Sources/NashiApp/SuccessToast.swift's layout (radius 22, mark + title + detail + action) on translucent glass. -->
  <Border x:Name="Card" Classes="card" Background="{DynamicResource NashiCanvasClear}">
    <Border.Transitions>
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.28" Easing="CubicEaseOut" />
      </Transitions>
    </Border.Transitions>
    <Panel>
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="18,0">
        <Image x:Name="MarkImage" Width="44" Height="44" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Margin="13,0" Spacing="5" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="DetailText" Classes="secondary" FontSize="11" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button x:Name="ShowButton" Grid.Column="2" Classes="secondary compact" VerticalAlignment="Center"
                Content="{l:T 'Show in folder'}" Click="OnShowInFolder" />
      </Grid>
    </Panel>
  </Border>
</Window>
