<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Nashi.Linux"
        x:Class="Nashi.Linux.WheelWindow"
        Title="Nashi"
        Width="320" Height="320" CanResize="False"
        SystemDecorations="None" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="Transparent" TransparencyLevelHint="Transparent"
        TransparencyBackgroundFallback="{DynamicResource NashiCanvasOpaque}">
  <!-- Home's wheel has the selected files as cards on either side (macOS's in-app look); the pointer wheel is bare. -->
  <Grid x:Name="Root" ColumnDefinitions="*,320,*" RenderTransformOrigin="50%,50%">
    <ContentControl x:Name="LeftCard" HorizontalAlignment="Center" VerticalAlignment="Center" />
    <local:Wheel x:Name="Ring" Grid.Column="1" />
    <ContentControl x:Name="RightCard" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
  </Grid>
</Window>
