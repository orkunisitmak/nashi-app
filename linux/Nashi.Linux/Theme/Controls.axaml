<!-- Nashi control classes: card, primary, secondary, quiet, pill (plus compact/gold/chip modifiers). -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <FontFamily x:Key="ContentControlThemeFontFamily">fonts:Inter#Inter</FontFamily>
    <!-- 16×16 glyphs. F1 = non-zero fill; the default is even-odd, which cuts holes where shapes overlap. -->
    <StreamGeometry x:Key="IconPlus">M7,2 H9 V7 H14 V9 H9 V14 H7 V9 H2 V7 H7 Z</StreamGeometry>
    <StreamGeometry x:Key="IconLock">F1 M4,7 H12 A1,1 0 0 1 13,8 V14 A1,1 0 0 1 12,15 H4 A1,1 0 0 1 3,14 V8 A1,1 0 0 1 4,7 Z M5,7 V5 A3,3 0 0 1 11,5 V7 H9.5 V5 A1.5,1.5 0 0 0 6.5,5 V7 Z</StreamGeometry>
    <StreamGeometry x:Key="IconSliders">F1 M1,3.25 H15 V4.75 H1 Z M1,7.25 H15 V8.75 H1 Z M1,11.25 H15 V12.75 H1 Z M8,4 A2,2 0 1 0 12,4 A2,2 0 1 0 8,4 Z M3,8 A2,2 0 1 0 7,8 A2,2 0 1 0 3,8 Z M9,12 A2,2 0 1 0 13,12 A2,2 0 1 0 9,12 Z</StreamGeometry>
    <StreamGeometry x:Key="IconSparkle">M8,1 Q8.8,7.2 15,8 Q8.8,8.8 8,15 Q7.2,8.8 1,8 Q7.2,7.2 8,1 Z</StreamGeometry>
    <StreamGeometry x:Key="IconArrowDown">M7.1,3 H8.9 V9.3 L11.2,7 L12.4,8.2 L8,12.6 L3.6,8.2 L4.8,7 L7.1,9.3 Z</StreamGeometry>
    <StreamGeometry x:Key="IconLeaf">M14,2 C6,2 2,5 2,10 C2,12 3,14 3,14 L4,13 C4,13 3.5,12 3.5,10.5 C6,10 9,8 11,5 C10,8.5 7,11 4.3,12.2 C5.5,13.5 7,14 8.5,14 C12.5,14 14,10 14,2 Z</StreamGeometry>
    <StreamGeometry x:Key="IconClose">F1 M3.5,4.6 L4.6,3.5 L8,6.9 L11.4,3.5 L12.5,4.6 L9.1,8 L12.5,11.4 L11.4,12.5 L8,9.1 L4.6,12.5 L3.5,11.4 L6.9,8 Z</StreamGeometry>
    <StreamGeometry x:Key="IconConvert">F1 M2,5 H11 L8.5,2.5 L9.6,1.4 L14,5.75 L9.6,10.1 L8.5,9 L11,6.5 H2 Z M14,9.5 H5 L7.5,7 L6.4,5.9 L2,10.25 L6.4,14.6 L7.5,13.5 L5,11 H14 Z</StreamGeometry>
    <StreamGeometry x:Key="IconTools">M2,6 H14 V13 H2 Z M6,6 V3.5 H10 V6 H8.8 V4.7 H7.2 V6 Z</StreamGeometry>
    <StreamGeometry x:Key="IconActions">F1 M1.5,7.5 L14.5,1.5 L10.5,14.5 L8,9 Z</StreamGeometry>
    <StreamGeometry x:Key="IconDocument">M3,1 H10 L14,5 V15 H3 Z M5,8 H12 V9 H5 Z M5,10.5 H12 V11.5 H5 Z</StreamGeometry>
    <StreamGeometry x:Key="IconPhoto">M1,3 H15 V13 H1 Z M3,11 L6.5,7 L9,9.5 L10.5,8 L13,11 Z M11,4.5 A1.3,1.3 0 1 1 11,7.1 A1.3,1.3 0 1 1 11,4.5 Z</StreamGeometry>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource NashiCanvas}" />
    <Setter Property="Foreground" Value="{DynamicResource NashiText}" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource NashiTextSecondary}" />
  </Style>

  <!-- card -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource NashiSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NashiBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource NashiCardRadius}" />
  </Style>
  <Style Selector="Border.card.targeted">
    <Setter Property="BorderBrush" Value="{DynamicResource NashiGold}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- primary / secondary / quiet buttons -->
  <Style Selector="Button.primary, Button.secondary, Button.quiet">
    <Setter Property="CornerRadius" Value="{StaticResource NashiButtonRadius}" />
    <Setter Property="Padding" Value="15,11" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.compact">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource NashiPrimaryFill}" />
    <Setter Property="Foreground" Value="{StaticResource NashiButtonInk}" />
    <Setter Property="BorderBrush" Value="#1FFFFFFF" />
  </Style>
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource NashiSurface}" />
    <Setter Property="Foreground" Value="{DynamicResource NashiText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NashiBorder}" />
  </Style>
  <Style Selector="Button.quiet">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource NashiText}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <!-- Fluent swaps the presenter brushes on hover, press and disable; keep Nashi's instead. -->
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource NashiPrimaryFill}" />
    <Setter Property="Foreground" Value="{StaticResource NashiButtonInk}" />
    <Setter Property="BorderBrush" Value="#1FFFFFFF" />
  </Style>
  <Style Selector="Button.primary:pointerover">
    <Setter Property="Effect">
      <DropShadowEffect OffsetX="0" OffsetY="3" BlurRadius="9" Color="#E3B859" Opacity="0.35" />
    </Setter>
  </Style>
  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NashiInset}" />
    <Setter Property="Foreground" Value="{DynamicResource NashiText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NashiBorder}" />
  </Style>
  <Style Selector="Button.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.quiet:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NashiHover}" />
    <Setter Property="Foreground" Value="{DynamicResource NashiText}" />
  </Style>
  <Style Selector="Button.secondary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NashiSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NashiBorder}" />
    <Setter Property="Foreground" Value="{DynamicResource NashiText}" />
  </Style>
  <Style Selector="Button.quiet:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource NashiText}" />
  </Style>
  <Style Selector="Button.primary:disabled, Button.secondary:disabled, Button.quiet:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <!-- A card-shaped button (the "Download a link" row). -->
  <Style Selector="Button.cardButton">
    <Setter Property="Background" Value="{DynamicResource NashiSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NashiBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource NashiCardRadius}" />
    <Setter Property="Padding" Value="18" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.cardButton:disabled">
    <Setter Property="Opacity" Value="0.6" />
  </Style>
  <Style Selector="Button.cardButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NashiSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NashiBorder}" />
    <Setter Property="Foreground" Value="{DynamicResource NashiText}" />
  </Style>

  <!-- pill: forest by default, .gold for the eyebrow -->
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="Background" Value="{DynamicResource NashiForestTint}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.pill TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource NashiForest}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.pill PathIcon">
    <Setter Property="Width" Value="9" />
    <Setter Property="Height" Value="9" />
    <Setter Property="Foreground" Value="{DynamicResource NashiForest}" />
  </Style>
  <Style Selector="Border.pill.gold">
    <Setter Property="Background" Value="{DynamicResource NashiGoldTint}" />
  </Style>
  <Style Selector="Border.pill.gold TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource NashiGoldInk}" />
  </Style>
  <Style Selector="Border.pill.gold PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource NashiGoldInk}" />
  </Style>

  <!-- chip: the small sage Convert / Tools / Actions buttons -->
  <Style Selector="Button.chip">
    <Setter Property="Background" Value="{DynamicResource NashiSageChip}" />
    <Setter Property="Foreground" Value="{DynamicResource NashiForest}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.chip:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NashiSage}" />
    <Setter Property="Foreground" Value="{DynamicResource NashiForest}" />
  </Style>
  <Style Selector="Button.chip PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource NashiForest}" />
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
  </Style>
</Styles>
