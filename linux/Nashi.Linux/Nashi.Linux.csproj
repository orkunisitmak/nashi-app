<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><AssemblyName>Nashi</AssemblyName><RootNamespace>Nashi.Linux</RootNamespace>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile><ApplicationIcon>../../Resources/Brand/NashiIcon.ico</ApplicationIcon>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport><DebugType>none</DebugType><DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../windows/Nashi.Core/Nashi.Core.csproj" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <!-- The same PDFium build as Windows, for page thumbnails, PDF to image and QR codes in PDFs. -->
    <PackageReference Include="bblanchon.PDFium.Linux" Version="155.0.8044" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="../../Resources/Brand/NashiIcon.png" Link="Assets/NashiIcon.png" />
    <AvaloniaResource Include="../../Resources/Brand/NashiMark.png" Link="Assets/NashiMark.png" />
    <AvaloniaResource Include="../../Resources/Brand/NashiMarkHappy.png" Link="Assets/NashiMarkHappy.png" />
    <Content Include="../../LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../windows/THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="packaging/nashi.desktop" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
