<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Nashi</AssemblyName>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier>$(NashiRuntimeIdentifier)</RuntimeIdentifier>
    <SelfContained Condition="'$(NashiPortable)' == 'true'">true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../windows/Nashi.Core/Nashi.Core.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <AvaloniaResource Include="../../Resources/Brand/NashiIcon.png" Link="Assets/NashiIcon.png" />
  </ItemGroup>
</Project>
